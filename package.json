{
  "name": "dsh-local-rewind",
  "version": "0.1.0",
  "description": "Local rewind/undo button for DeepSeek Harness Web: retract a message and everything after it without polluting the model context.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "GG915GG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GG915GG/dsh-local-rewind.git"
  },
  "homepage": "https://github.com/GG915GG/dsh-local-rewind#readme",
  "bugs": {
    "url": "https://github.com/GG915GG/dsh-local-rewind/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "rewind",
    "undo",
    "chat",
    "transcript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
